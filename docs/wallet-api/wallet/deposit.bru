meta {
  name: Deposit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/wallet
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "walletId": "{{walletId}}",
    "operationType": "DEPOSIT",
    "amount": 1000
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
  walletId: 13586b6c-7336-4361-bd96-ce053848604e
}

assert {
  res.status: eq 200
  res.body.operationType: eq DEPOSIT
  res.body.walletId: eq {{walletId}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Поле идентификатора — только `walletId`. Первый вызов создаёт кошелёк.
  
  Сохранённые примеры ответов:
  
  200 OK. Первый депозит создаёт кошелёк. Следующий прибавляет 1000 к балансу.
  
  ```json
  {
    "walletId": "6ba7b810-9dad-11d1-80b4-00c04fd430c8",
    "operationType": "DEPOSIT",
    "balance": 1000
  }
  ```
  
  422 Unprocessable Entity. Тело не разбирается как JSON, в том числе дробный amount.
  
  ```json
  {
    "error": "invalid json"
  }
  ```
  
  422 Unprocessable Entity. Сумма ноль, отрицательная или не помещается в BIGINT.
  
  ```json
  {
    "error": "invalid amount"
  }
  ```
  
  422 Unprocessable Entity. Тип операции не DEPOSIT и не WITHDRAW.
  
  ```json
  {
    "error": "invalid operation type"
  }
  ```
  
  422 Unprocessable Entity. Нет walletId, ключ записан иначе или UUID нулевой.
  
  ```json
  {
    "error": "invalid wallet id"
  }
  ```
  
  422 Unprocessable Entity. Тело больше 4096 байт.
  
  ```json
  {
    "error": "request body is too large"
  }
  ```
  
  415 Unsupported Media Type. Content-Type задан и это не application/json. Пустой заголовок принимается.
  
  ```json
  {
    "error": "content type must be application/json"
  }
  ```
  
  503 Service Unavailable. Postgres недоступен или запрос к нему завершился ошибкой.
  
  ```json
  {
    "error": "service unavailable"
  }
  ```
  
  500 Internal Server Error. Обработчик паникует. До базы запрос не считается выполненным.
  
  ```json
  {
    "error": "internal error"
  }
  ```
}

example {
  name: 200 OK
  description: Первый депозит создаёт кошелёк. Следующий прибавляет 1000 к балансу.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "DEPOSIT",
        "amount": 1000
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "walletId": "6ba7b810-9dad-11d1-80b4-00c04fd430c8",
          "operationType": "DEPOSIT",
          "balance": 1000
        }
      '''
    }
  }
}

example {
  name: 422 invalid json
  description: Тело не разбирается как JSON, в том числе дробный amount.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {"walletId":}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "invalid json"
        }
      '''
    }
  }
}

example {
  name: 422 invalid amount
  description: Сумма ноль, отрицательная или не помещается в BIGINT.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "DEPOSIT",
        "amount": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "invalid amount"
        }
      '''
    }
  }
}

example {
  name: 422 invalid operation
  description: Тип операции не DEPOSIT и не WITHDRAW.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "TRANSFER",
        "amount": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "invalid operation type"
        }
      '''
    }
  }
}

example {
  name: 422 invalid wallet id
  description: Нет walletId, ключ записан иначе или UUID нулевой.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "walletId": "00000000-0000-0000-0000-000000000000",
        "operationType": "DEPOSIT",
        "amount": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "invalid wallet id"
        }
      '''
    }
  }
}

example {
  name: 422 body too large
  description: Тело больше 4096 байт.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {"operationType":"","walletId":"11111111-1111-1111-1111-111111111111","amount":1}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "request body is too large"
        }
      '''
    }
  }
}

example {
  name: 415 Unsupported Media Type
  description: Content-Type задан и это не application/json. Пустой заголовок принимается.
  
  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: text
    headers: {
      Content-Type: text/plain
    }
  
    body:text: {
      {"walletId":"{{walletId}}","operationType":"DEPOSIT","amount":1}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }
  
    status: {
      code: 415
      text: Unsupported Media Type
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "content type must be application/json"
        }
      '''
    }
  }
}

