meta {
  name: Invalid amount
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/wallet
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "walletId": "{{walletId}}",
    "operationType": "DEPOSIT",
    "amount": 0
  }
}

docs {
  Ноль не принимается.

  Сохранённые примеры ответов:

  422 Unprocessable Entity. Ноль, отрицательная сумма и переполнение BIGINT дают один и тот же текст.

  ```json
  {
    "error": "invalid amount"
  }
  ```

  500 Internal Server Error. Обработчик паникует. До базы запрос не считается выполненным.

  ```json
  {
    "error": "internal error"
  }
  ```
}

example {
  name: 422 Unprocessable Entity
  description: Ноль, отрицательная сумма и переполнение BIGINT дают один и тот же текст.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "DEPOSIT",
        "amount": 0
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": "invalid amount"
        }
      '''
    }
  }
}

example {
  name: 500 Internal Server Error
  description: Обработчик паникует. До базы запрос не считается выполненным.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "DEPOSIT",
        "amount": 0
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": "internal error"
        }
      '''
    }
  }
}

assert {
  res.status: eq 422
  res.body.error: eq invalid amount
}

settings {
  encodeUrl: true
}
