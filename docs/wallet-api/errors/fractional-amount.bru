meta {
  name: Fractional amount
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/wallet
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "walletId": "{{walletId}}",
    "operationType": "DEPOSIT",
    "amount": 1000.5
  }
}

docs {
  Дробный amount не разбирается как целое число.

  Сохранённые примеры ответов:

  422 Unprocessable Entity. Дробное число не записывается в целое amount.

  ```json
  {
    "error": "invalid json"
  }
  ```

  422 Unprocessable Entity. Тело больше 4096 байт.

  ```json
  {
    "error": "request body is too large"
  }
  ```

  500 Internal Server Error. Обработчик паникует. До базы запрос не считается выполненным.

  ```json
  {
    "error": "internal error"
  }
  ```
}

example {
  name: 422 invalid json
  description: Дробное число не записывается в целое amount.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "DEPOSIT",
        "amount": 1000.5
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": "invalid json"
        }
      '''
    }
  }
}

example {
  name: 422 body too large
  description: Тело больше 4096 байт.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {"operationType":"","walletId":"11111111-1111-1111-1111-111111111111","amount":1}
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": "request body is too large"
        }
      '''
    }
  }
}

example {
  name: 500 Internal Server Error
  description: Обработчик паникует. До базы запрос не считается выполненным.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "walletId": "{{walletId}}",
        "operationType": "DEPOSIT",
        "amount": 1000.5
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": "internal error"
        }
      '''
    }
  }
}

assert {
  res.status: eq 422
  res.body.error: eq invalid json
}

settings {
  encodeUrl: true
}
