meta {
  name: Wrong content type
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/wallet
  body: text
  auth: none
}

headers {
  Content-Type: text/plain
}

body:text {
  {"walletId":"{{walletId}}","operationType":"DEPOSIT","amount":1}
}

docs {
  Явный Content-Type, отличный от application/json, отклоняется до разбора тела. Пустой заголовок принимается как JSON.

  Сохранённые примеры ответов:

  415 Unsupported Media Type. Content-Type задан и это не application/json. Пустой заголовок принимается.

  ```json
  {
    "error": "content type must be application/json"
  }
  ```

  500 Internal Server Error. Обработчик паникует. До базы запрос не считается выполненным.

  ```json
  {
    "error": "internal error"
  }
  ```
}

example {
  name: 415 Unsupported Media Type
  description: Content-Type задан и это не application/json. Пустой заголовок принимается.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: text
    headers: {
      Content-Type: text/plain
    }
    body:text: {
      {"walletId":"{{walletId}}","operationType":"DEPOSIT","amount":1}
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 415
      text: Unsupported Media Type
    }

    body: {
      type: json
      content: '''
        {
          "error": "content type must be application/json"
        }
      '''
    }
  }
}

example {
  name: 500 Internal Server Error
  description: Обработчик паникует. До базы запрос не считается выполненным.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: text
    headers: {
      Content-Type: text/plain
    }
    body:text: {
      {"walletId":"{{walletId}}","operationType":"DEPOSIT","amount":1}
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": "internal error"
        }
      '''
    }
  }
}

assert {
  res.status: eq 415
  res.body.error: eq content type must be application/json
}

settings {
  encodeUrl: true
}
