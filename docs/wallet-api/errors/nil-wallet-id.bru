meta {
  name: Nil wallet id
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/wallet
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "walletId": "00000000-0000-0000-0000-000000000000",
    "operationType": "DEPOSIT",
    "amount": 1
  }
}

docs {
  Нулевой UUID не принимается. Так же отвечает тело без walletId и тело с другим именем ключа.

  Сохранённые примеры ответов:

  422 Unprocessable Entity. До базы такой запрос не доходит.

  ```json
  {
    "error": "invalid wallet id"
  }
  ```

  500 Internal Server Error. Обработчик паникует. До базы запрос не считается выполненным.

  ```json
  {
    "error": "internal error"
  }
  ```
}

example {
  name: 422 Unprocessable Entity
  description: До базы такой запрос не доходит.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "walletId": "00000000-0000-0000-0000-000000000000",
        "operationType": "DEPOSIT",
        "amount": 1
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 422
      text: Unprocessable Entity
    }

    body: {
      type: json
      content: '''
        {
          "error": "invalid wallet id"
        }
      '''
    }
  }
}

example {
  name: 500 Internal Server Error
  description: Обработчик паникует. До базы запрос не считается выполненным.

  request: {
    url: {{baseUrl}}/api/v1/wallet
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "walletId": "00000000-0000-0000-0000-000000000000",
        "operationType": "DEPOSIT",
        "amount": 1
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 500
      text: Internal Server Error
    }

    body: {
      type: json
      content: '''
        {
          "error": "internal error"
        }
      '''
    }
  }
}

assert {
  res.status: eq 422
  res.body.error: eq invalid wallet id
}

settings {
  encodeUrl: true
}
